# MySQL
MYSQL_DATABASE=volunteer_platform
MYSQL_USER=volunteer
MYSQL_PASSWORD=volunteer_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Backend
DB_URL=mysql+pymysql://volunteer:volunteer_password@mysql:3306/volunteer_platform
SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# Matching defaults from the project specification (used in a later phase)
MATCHING_SKILLS_WEIGHT=0.45
MATCHING_INTEREST_WEIGHT=0.20
MATCHING_LOCATION_WEIGHT=0.20
MATCHING_AVAILABILITY_WEIGHT=0.15

# Frontend
VITE_API_URL=http://localhost:8000
